table Sankey_Facultad_Depto
	lineageTag: 7b944efc-3851-47f5-a5e4-770c2f96ee7c

	column Facultad
		lineageTag: f2d8822e-0b2d-4172-8bc3-1a1cae10be00
		summarizeBy: none
		isNameInferred
		sourceColumn: [Facultad]

		annotation SummarizationSetBy = Automatic

	column Departamento
		lineageTag: 6e132234-1e12-4582-8423-149ab54c666c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Departamento]

		annotation SummarizationSetBy = Automatic

	column Conexiones
		formatString: 0
		lineageTag: 61a9090c-bef8-495d-984c-54c730631125
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Conexiones]

		annotation SummarizationSetBy = Automatic

	partition Sankey_Facultad_Depto = calculated
		mode: import
		source = ```
				
				VAR TablaBase = 
				    SUMMARIZE(
				        silver_catastropure,
				        silver_catastropure[investigador],
				        silver_catastropure[Vicerrectorado],
				        silver_catastropure[Unidad_Investigacion]
				    )
				
				VAR Academicos = 
				    SELECTCOLUMNS(
				        FILTER(
				            TablaBase,
				            [Vicerrectorado] = "Vicerrectorado Académico"
				        ),
				        "investigador", [investigador],
				        "Facultad", [Unidad_Investigacion]
				    )
				
				VAR Investigacion = 
				    SELECTCOLUMNS(
				        FILTER(
				            TablaBase,
				            [Vicerrectorado] = "Vicerrectorado de Investigación e Innovación"
				        ),
				        "investigador", [investigador],
				        "Departamento", [Unidad_Investigacion]
				    )
				
				VAR Cruzado = 
				    NATURALINNERJOIN(Academicos, Investigacion)
				
				VAR Agrupado = 
				    SUMMARIZE(
				        Cruzado,
				        [Facultad],
				        [Departamento],
				        "Conexiones", COUNTROWS(Cruzado)
				    )
				
				RETURN
				    Agrupado
				```

	annotation PBI_Id = c69045901ab54d278d65b7468772cd6b

