	partition silver_catastropure = m
		mode: import
		source =
				let
				    Origen = Table.NestedJoin(silver_investigadores, {"merge"}, silver_jerarquía, {"grupo_merge_jerarquia"}, "silver_jerarquía", JoinKind.Inner),
				    #"Se expandió silver_jerarquía" = Table.ExpandTableColumn(Origen, "silver_jerarquía", {"Vicerrectorado", "Unidad_Investigacion"}, {"Vicerrectorado", "Unidad_Investigacion"})
				in
