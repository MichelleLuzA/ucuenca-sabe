	hierarchy 'Unidad_abreviada Jerarquía'
		lineageTag: a43093fc-39b4-42bf-a8e9-b9554a0a0a7b

		level Unidad_abreviada
			lineageTag: 1a58f49f-7d77-49a8-9747-f095ff92058f
			column: Unidad_abreviada

		level grupo_investigacion
			lineageTag: 25caa3cd-9368-456c-8522-ad946b272de1
			column: grupo_investigacion

	partition silver_catastropure = m
		mode: import
		source =
				let
				    Origen = Table.NestedJoin(silver_investigadores, {"merge"}, silver_jerarquía, {"grupo_merge_jerarquia"}, "silver_jerarquía", JoinKind.Inner),
				    #"Se expandió silver_jerarquía" = Table.ExpandTableColumn(Origen, "silver_jerarquía", {"Vicerrectorado", "Unidad_Investigacion"}, {"Vicerrectorado", "Unidad_Investigacion"}),
				    #"Texto limpio" = Table.TransformColumns(#"Se expandió silver_jerarquía",{{"investigador", Text.Clean, type text}}),
				    #"Texto recortado" = Table.TransformColumns(#"Texto limpio",{{"investigador", Text.Trim, type text}}),
				    #"Texto en mayúsculas" = Table.TransformColumns(#"Texto recortado",{{"investigador", Text.Upper, type text}}),
				    #"Consultas combinadas" = Table.NestedJoin(#"Texto en mayúsculas", {"investigador"}, catastro_docentes, {"investigador"}, "catastro_docentes", JoinKind.LeftOuter),
				    #"Se expandió catastro_docentes" = Table.ExpandTableColumn(#"Consultas combinadas", "catastro_docentes", {"GENERO", "FECHA_NACIMIENTO", "TIPO_SERVIDOR", "ESTADO", "CARGO", "FECHA_INGRESO", "FECHA_TITULARIDAD", "MODALIDAD_EMPLEO", "CALIDAD", "DEPENDENCIA", "CANTON DE RESIDENCIA", "TIPO_DEDICACION_1", "TIPO_DEDICACION_2", "UNIDAD ACADÉMICA_1", "UNIDAD ACADÉMICA_2", "NOMBRES COMPLETOS", "PAIS ORIGEN", "TIPO_PERSONAL", "SEXO", "AÑO OBTENCIÓN TITULO", "PAIS ESTUDIO", "NIVEL TÍTULO", "TIPO TÍTULO", "NOMBRE TÍTULO", "CAMPO AMPLIO (UNESCO)", "CAMPO ESPECÍFICO (UNESCO)", "CAMPO DETALLADO (UNESCO)"}, {"GENERO", "FECHA_NACIMIENTO", "TIPO_SERVIDOR", "ESTADO", "CARGO", "FECHA_INGRESO", "FECHA_TITULARIDAD", "MODALIDAD_EMPLEO", "CALIDAD", "DEPENDENCIA", "CANTON DE RESIDENCIA", "TIPO_DEDICACION_1", "TIPO_DEDICACION_2", "UNIDAD ACADÉMICA_1", "UNIDAD ACADÉMICA_2", "NOMBRES COMPLETOS", "PAIS ORIGEN", "TIPO_PERSONAL", "SEXO", "AÑO OBTENCIÓN TITULO", "PAIS ESTUDIO", "NIVEL TÍTULO", "TIPO TÍTULO", "NOMBRE TÍTULO", "CAMPO AMPLIO (UNESCO)", "CAMPO ESPECÍFICO (UNESCO)", "CAMPO DETALLADO (UNESCO)"}),
				    #"Personalizada agregada" = Table.AddColumn(#"Se expandió catastro_docentes", "Unidad_abreviada", each Text.Replace(
				    Text.Replace(
				        Text.Replace([Unidad_Investigacion], "Facultad de ", ""),
				    "Departamento de ", ""),
				"Departamento Interdisciplinario de ", "")),
				    #"Filas filtradas" = Table.SelectRows(#"Personalizada agregada", each true),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Filas filtradas",{{"AÑO OBTENCIÓN TITULO", Int64.Type}}),
				    #"Personalizada agregada1" = Table.AddColumn(#"Tipo cambiado", "CAMPO ESPECÍFICO (UNESCO)_limpio", each let
				    texto = Text.Upper([#"CAMPO ESPECÍFICO (UNESCO)"]),
				    palabras = Text.Split(texto, " "),
				    stopwords = {"DE", "LA", "EL", "LOS", "LAS", "DEL", "EN", "Y", "E", "O", "A", "AL", "CON", "POR", "PARA", "SU", "SE", "UN", "UNA", "UNOS", "UNAS", "LO", "LE", "ES", "AFINES","NO", "SI", "COMO", "MÁS", "PERO", "ENTRE", "HASTA", "DESDE", "SOBRE", "TODO", "OTRO", "OTRA", "OTROS", "OTRAS", "ESTE", "ESTA", "ESTOS", "ESTAS", "ESE", "ESA", "ESOS", "ESAS", "AQUEL", "AQUELLA", "AQUELLOS", "AQUELLAS"},
				    filtradas = List.Select(palabras, each not List.Contains(stopwords, _)),
				    resultado = Text.Combine(filtradas, " ")
				in
				    resultado),
				    #"Valor reemplazado" = Table.ReplaceValue(#"Personalizada agregada1","REINO UNIDO (INGLATERRA)","REINO UNIDO",Replacer.ReplaceText,{"PAIS ESTUDIO"}),
				    #"Valor reemplazado1" = Table.ReplaceValue(#"Valor reemplazado","ESTADOS UNIDOS","USA",Replacer.ReplaceText,{"PAIS ESTUDIO"}),
				    #"Valor reemplazado2" = Table.ReplaceValue(#"Valor reemplazado1","USA","U.S.A",Replacer.ReplaceText,{"PAIS ESTUDIO"}),
				    #"Personalizada agregada2" = Table.AddColumn(#"Valor reemplazado2", "Key_nombre", each Text.Upper(
				    Text.Replace(
				        Text.Replace(
				            Text.Replace(
				                Text.Replace(
				                    Text.Replace(
				                        Text.Replace(
				                            Text.Replace(
				                                Text.Replace(
				                                    Text.Replace(
				                                        Text.Trim(Text.Clean([investigador])),
				                                        "Á", "A"
				                                    ),
				                                    "É", "E"
				                                ),
				                                "Í", "I"
				                            ),
