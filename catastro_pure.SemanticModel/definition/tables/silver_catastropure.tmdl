table silver_catastropure
	excludeFromModelRefresh
	lineageTag: f4a8ca57-0461-4fa9-9503-2c64037042e0

	measure 'Total Investigadores' = DISTINCTCOUNT('silver_catastropure'[investigador])
		formatString: 0
		lineageTag: 66774682-34c4-4e09-9870-7aeabebc4c2d

	measure 'Total Grupos' = DISTINCTCOUNT('silver_catastropure'[grupo_investigacion])
		formatString: 0
		lineageTag: b8d1b728-e49f-4783-bc95-05b1b312c14e

	measure 'Inv Académico' = CALCULATE([Total Investigadores], silver_catastropure[Vicerrectorado]= "Vicerrectorado Académico")
		formatString: 0
		lineageTag: 97222c0d-5c21-49b7-b614-66ee18f2443b

	measure 'Inv Investigación' = CALCULATE([Total Investigadores], 'silver_catastropure'[Vicerrectorado] = "Vicerrectorado de Investigación e Innovación")
		formatString: 0
		lineageTag: ac619093-6c5f-4297-83df-716a3d573968

	measure 'Grupos Académico' = CALCULATE([Total Grupos], 'silver_catastropure'[Vicerrectorado] = "Vicerrectorado Académico")
		formatString: 0
		lineageTag: 80924336-a0da-4439-bb4e-e5e8924e5b92

	measure 'Grupos Investigación' = CALCULATE([Total Grupos], 'silver_catastropure'[Vicerrectorado] = "Vicerrectorado de Investigación e Innovación", 'silver_catastropure'[grupo_investigacion] <> "Sin grupo asignado")
		formatString: 0
		lineageTag: e6c7c57f-ed86-41da-99ce-63530f66d0fd

	measure 'Total Facultades' =
			
			CALCULATE(
			    DISTINCTCOUNT('silver_catastropure'[Unidad_Investigacion]),
			    'silver_catastropure'[Vicerrectorado] = "Vicerrectorado Académico"
			)
		formatString: 0
		lineageTag: 8e9c37a1-e130-4619-8ae6-0dd253db294e

	measure 'Total Departamentos' =
			
			CALCULATE(
			    DISTINCTCOUNT('silver_catastropure'[Unidad_Investigacion]),
			    'silver_catastropure'[Vicerrectorado] = "Vicerrectorado de Investigación e Innovación"
			)
		formatString: 0
		lineageTag: dea29e65-6ad8-4c06-a33d-845338b40a56

