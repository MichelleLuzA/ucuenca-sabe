table silver_catastropure
	excludeFromModelRefresh
	lineageTag: f4a8ca57-0461-4fa9-9503-2c64037042e0

	measure 'Total Investigadores' = DISTINCTCOUNT('silver_catastropure'[investigador])
		formatString: 0
		lineageTag: 66774682-34c4-4e09-9870-7aeabebc4c2d

	measure 'Total Grupos' = DISTINCTCOUNT('silver_catastropure'[grupo_investigacion])
		formatString: 0
		lineageTag: b8d1b728-e49f-4783-bc95-05b1b312c14e

	measure 'Inv Académico' = CALCULATE([Total Investigadores], silver_catastropure[Vicerrectorado]= "Vicerrectorado Académico")
		formatString: 0
		lineageTag: 97222c0d-5c21-49b7-b614-66ee18f2443b

	measure 'Inv Investigación' = CALCULATE([Total Investigadores], 'silver_catastropure'[Vicerrectorado] = "Vicerrectorado de Investigación e Innovación")
		formatString: 0
		lineageTag: ac619093-6c5f-4297-83df-716a3d573968

	measure 'Grupos Académico' = CALCULATE([Total Grupos], 'silver_catastropure'[Vicerrectorado] = "Vicerrectorado Académico")
		formatString: 0
		lineageTag: 80924336-a0da-4439-bb4e-e5e8924e5b92

	measure 'Grupos Investigación' = CALCULATE([Total Grupos], 'silver_catastropure'[Vicerrectorado] = "Vicerrectorado de Investigación e Innovación", 'silver_catastropure'[grupo_investigacion] <> "Sin grupo asignado")
		formatString: 0
		lineageTag: e6c7c57f-ed86-41da-99ce-63530f66d0fd

	measure 'Total Facultades' =
			
			CALCULATE(
			    DISTINCTCOUNT('silver_catastropure'[Unidad_Investigacion]),
			    'silver_catastropure'[Vicerrectorado] = "Vicerrectorado Académico"
			)
		formatString: 0
		lineageTag: 8e9c37a1-e130-4619-8ae6-0dd253db294e

	measure 'Total Departamentos' =
			
			CALCULATE(
			    DISTINCTCOUNT('silver_catastropure'[Unidad_Investigacion]),
			    'silver_catastropure'[Vicerrectorado] = "Vicerrectorado de Investigación e Innovación"
			)
		formatString: 0
		lineageTag: dea29e65-6ad8-4c06-a33d-845338b40a56

	measure Total_PhD = ```
			
			CALCULATE(
			    [Total Investigadores],
			    'silver_catastropure'[TIPO TÍTULO] = "DOCTOR (Ph.D)"
			)
			
			```
		formatString: 0
		lineageTag: 19ebe20d-1e67-4e9e-8dc5-83c0e8d6abc6

	measure Total_Maestria =
			
			CALCULATE(
			    [Total Investigadores],
			    'silver_catastropure'[TIPO TÍTULO] = "MAESTRÍA O EQUIVALENTE"
			)
		formatString: 0
		lineageTag: a545bf05-13be-42d3-8ccf-7f598eb8c96d

	measure Total_Especia_Salud =
			
			CALCULATE(
			    [Total Investigadores],
			    'silver_catastropure'[TIPO TÍTULO] = "ESPECIALISTA AREA SALUD"
			)
		formatString: 0
		lineageTag: 5f8b6ad2-9ea4-4b96-bc50-2d2b553cc786

	measure Pct_PhD =
			
			DIVIDE([Total_PhD], [Total Investigadores], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: bb74c94d-613e-419a-ae94-2bb16f3d9098

	measure Pct_Especialidad_Salud =
			
			DIVIDE([Total_Especia_Salud], [Total Investigadores], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1811d02a-3f39-456f-9be2-f8658b035a82

	measure Pct_Maestria =
			
			DIVIDE([Total_Maestria], [Total Investigadores], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3d120090-4079-4e4c-a23f-62741c2444bc

	measure Antiguedad_Promedio =
			
			AVERAGEX(
			    'silver_catastropure',
			    DATEDIFF('silver_catastropure'[FECHA_INGRESO], TODAY(), YEAR)
			)
		lineageTag: 6fbc8557-fc50-4361-8e27-75511422e8f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Años_Titularidad =
			
			AVERAGEX(
			    FILTER(
			        silver_catastropure,
			        NOT ISBLANK(silver_catastropure[FECHA_TITULARIDAD]) &&
			        NOT ISBLANK(silver_catastropure[FECHA_INGRESO])
			    ),
			    DATEDIFF(silver_catastropure[FECHA_INGRESO], silver_catastropure[FECHA_TITULARIDAD], YEAR)
			)
		lineageTag: a9c457c7-4237-4264-806b-84ba333c1a12

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Antiguedad_General =
			
			AVERAGEX(
			    FILTER(
			        silver_catastropure,
			        NOT ISBLANK(silver_catastropure[FECHA_INGRESO])
			    ),
			    DATEDIFF(silver_catastropure[FECHA_INGRESO], TODAY(), YEAR)
			)
		lineageTag: be532b45-fbb8-4d05-9337-5dcc3eac95df

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Inv_Principales =
			
			CALCULATE(
			    [Total Investigadores],
			    silver_catastropure[CALIDAD] = "PRINCIPAL"
			)
		formatString: 0
		lineageTag: 2836f407-28e6-4cc6-9de7-77961665cf91

	measure Pct_Principales =
			
			DIVIDE([Inv_Principales], [Total_Investigadores], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: b3fdf546-b930-4fe0-9e34-329325d9c391

	measure Inv_Agregados = ```
			
			CALCULATE(
			    [Total Investigadores],
			    silver_catastropure[CALIDAD] = "AGREGADO"
			)
			
			```
		formatString: 0
		lineageTag: 397fef67-bdc8-4d6a-b27c-d1bf4829739a

	measure Pct_Agregados = ```
			
			DIVIDE([Inv_Agregados], [Total Investigadores], 0)
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3f0bd62e-8363-4755-aea5-545751dfd351

	measure Inv_Auxiliares =
			
			CALCULATE(
			    [Total Investigadores],
			    silver_catastropure[CALIDAD] = "AUXILIAR"
			)
		formatString: 0
		lineageTag: 3596dc90-ade0-4301-8a65-75afe3cbed38

	measure Pct_Auxiliares =
			
			DIVIDE([Inv_Auxiliares], [Total Investigadores], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: c87998c0-c286-4a76-a9fc-f4aa90798289

